pkgname=jingyue_control
pkgver=1.4.6
pkgrel=0
epoch=
pkgdesc="JingyueControl 鲸跃远控 - Remote Desktop Software"
arch=('x86_64')
url="https://jingyue.rqrt2122.cn"
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'pam' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/jingyue_control" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/jingyue_control"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/jingyue_control/jingyue_control usr/bin/jingyue_control && popd
  install -Dm 644 $HBB/res/jingyue_control.service -t "${pkgdir}/usr/share/jingyue_control/files"
  install -Dm 644 $HBB/res/jingyue_control.desktop -t "${pkgdir}/usr/share/jingyue_control/files"
  install -Dm 644 $HBB/res/jingyue_control-link.desktop -t "${pkgdir}/usr/share/jingyue_control/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/jingyue_control.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/jingyue_control.svg"
}